DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/metroscales
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d
# Comma-separated list of allowed admin panel origins
CORS_ORIGIN=http://localhost:4200
# Enables /api/device-sim/* endpoints that fake a scale (heartbeats, bills).
# Keep false in production until the real scale gateway exists.
DEVICE_SIMULATOR=false
# First dealer admin, created by `npm run db:seed:prod`
SEED_ADMIN_USERNAME=admin
# Optional
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=change-me
PORT=3000
